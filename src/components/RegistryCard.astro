---
interface RouteInfo {
  id: string;
  name: string;
  distance_km: number | null;
  difficulty: string | null;
  description: string;
  mapUrl: string;
}

interface Props {
  registryId: number;
  submissionId: string;
  riderName: string;
  location: string;
  photoUrl?: string;
  photoUrls?: string[];
  message?: string;
  route?: RouteInfo | null;
  riderRoute?: string | null;
  postLikeCount?: number;
}

const { registryId, submissionId, riderName, location, photoUrl, photoUrls, message, route, riderRoute, postLikeCount } = Astro.props;
const tkid = `TKID-${String(registryId).padStart(4, '0')}`;
const photos = (photoUrls && photoUrls.length > 0) ? photoUrls : (photoUrl ? [photoUrl] : []);
---

<article
  class="registry-card"
  data-photo={photoUrl || ''}
  data-photos={JSON.stringify(photos)}
  data-tkid={tkid}
  data-rider={riderName}
  data-location={location}
  data-message={message || ''}
  data-route={route ? JSON.stringify(route) : ''}
  data-rider-route={riderRoute || ''}
  data-submission-id={submissionId}
  data-post-likes={String(postLikeCount ?? 0)}
  style="cursor: pointer;"
>
  {photoUrl ? (
    <img class="card-img" src={photoUrl} alt={`${riderName}'s ride`} loading="lazy" />
  ) : (
    <div class="card-img-placeholder notranslate">TRACKID</div>
  )}
  <div class="card-meta">
    <div class="card-id">{tkid}</div>
    <div class="card-rider">{riderName}</div>
    <div class="card-loc-row">
      <div class="card-loc">{location}</div>
      <button class="card-like" type="button" data-post-id={submissionId} aria-pressed="false" aria-label="Like this post">
        <span class="card-like-heart" aria-hidden="true">&#9829;</span>
        <span class="card-like-count">{postLikeCount ?? 0}</span>
      </button>
    </div>
    {message && <div class="card-msg">"{message}"</div>}
  </div>
</article>
