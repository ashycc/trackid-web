---
interface RouteInfo {
  name: string;
  distance_km: number | null;
  difficulty: string | null;
  description: string;
  mapUrl: string;
}

interface Props {
  registryId: number;
  riderName: string;
  location: string;
  photoUrl?: string;
  photoUrls?: string[];
  message?: string;
  route?: RouteInfo | null;
  riderRoute?: string | null;
}

const { registryId, riderName, location, photoUrl, photoUrls, message, route, riderRoute } = Astro.props;
const tkid = `TKID-${String(registryId).padStart(4, '0')}`;
const photos = (photoUrls && photoUrls.length > 0) ? photoUrls : (photoUrl ? [photoUrl] : []);
---

<article
  class="registry-card"
  data-photo={photoUrl || ''}
  data-photos={JSON.stringify(photos)}
  data-tkid={tkid}
  data-rider={riderName}
  data-location={location}
  data-message={message || ''}
  data-route={route ? JSON.stringify(route) : ''}
  data-rider-route={riderRoute || ''}
  style="cursor: pointer;"
>
  {photoUrl ? (
    <img class="card-img" src={photoUrl} alt={`${riderName}'s ride`} loading="lazy" />
  ) : (
    <div class="card-img-placeholder notranslate">TRACKID</div>
  )}
  <div class="card-meta">
    <div class="card-id">{tkid}</div>
    <div class="card-rider">{riderName}</div>
    <div class="card-loc">{location}</div>
    {message && <div class="card-msg">"{message}"</div>}
  </div>
</article>
