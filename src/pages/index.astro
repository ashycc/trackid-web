---
import Layout from '../layouts/Layout.astro';
import RegistryCard from '../components/RegistryCard.astro';
import StatsBar from '../components/StatsBar.astro';
import MapSection from '../components/MapSection.astro';
import { supabaseAdmin } from '../lib/supabase';
import { cityKey, googleMapsRouteUrl } from '../lib/routes';
import stickerCustomers from '../data/sticker-customers.json';

export const prerender = false;

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;

// Fetch approved submissions
const { data: submissions } = await supabaseAdmin
  .from('submissions')
  .select('*')
  .eq('status', 'approved')
  .order('registry_id', { ascending: false });

const riders = submissions ?? [];

// Fetch published cycling routes and index by city_key for O(1) rider lookup.
const { data: routeRows } = await supabaseAdmin
  .from('routes')
  .select('*')
  .eq('status', 'published');

interface RouteInfo {
  name: string;
  distance_km: number | null;
  difficulty: string | null;
  description: string;
  mapUrl: string;
}
const routesByCity = new Map<string, RouteInfo>();
const routePolylines: Array<{ name: string; points: [number, number][] }> = [];
(routeRows ?? []).forEach((r) => {
  const wps = Array.isArray(r.waypoints) ? r.waypoints : [];
  routesByCity.set(r.city_key, {
    name: r.name || `${r.city} Classic`,
    distance_km: r.distance_km ?? null,
    difficulty: r.difficulty ?? null,
    description: r.description || '',
    mapUrl: googleMapsRouteUrl(wps),
  });
  if (wps.length >= 2) {
    routePolylines.push({
      name: r.name || r.city,
      points: wps.map((w: { lng: number; lat: number }) => [w.lng, w.lat] as [number, number]),
    });
  }
});

function routeForLocation(location: string): RouteInfo | null {
  return routesByCity.get(cityKey(location)) ?? null;
}

// Normalize country names (handle Chinese/variant names)
const countryNormalize: Record<string, string> = {
  '中国': 'China', '日本': 'Japan', '韩国': 'South Korea',
  '德国': 'Germany', '法国': 'France', '瑞士': 'Switzerland',
  '加拿大': 'Canada', '澳大利亚': 'Australia', '新加坡': 'Singapore',
};
function normalizeCountry(c: string): string {
  return countryNormalize[c] || c;
}

// Compute stats (riders + sticker customers, deduplicated)
const riderCountries = riders.map(r => normalizeCountry(r.location.split(',').pop()?.trim() || '')).filter(Boolean);
const customerCountries = stickerCustomers.map(c => c.country);
const countries = new Set([...riderCountries, ...customerCountries]).size;

const riderCities = riders.map(r => r.location.split(',')[0]?.trim().toLowerCase()).filter(Boolean);
const customerCities = stickerCustomers.map(c => c.city.toLowerCase());
const cities = new Set([...riderCities, ...customerCities]).size;

const totalRiders = riders.length;

function photoUrl(path: string): string {
  return `${supabaseUrl}/storage/v1/object/public/rider-photos/${path}`;
}

function coverPath(r: { photo_paths?: string[] | null; cover_index?: number | null }): string {
  const paths = Array.isArray(r.photo_paths) ? r.photo_paths : [];
  if (paths.length === 0) return '';
  const idx = typeof r.cover_index === 'number' && r.cover_index >= 0 && r.cover_index < paths.length
    ? r.cover_index
    : 0;
  return paths[idx];
}

// Ordered photo URLs with the cover first, then the rest in original order.
function orderedPhotoUrls(r: { photo_paths?: string[] | null; cover_index?: number | null }): string[] {
  const paths = Array.isArray(r.photo_paths) ? r.photo_paths : [];
  if (paths.length === 0) return [];
  const idx = typeof r.cover_index === 'number' && r.cover_index >= 0 && r.cover_index < paths.length
    ? r.cover_index
    : 0;
  return [paths[idx], ...paths.filter((_, i) => i !== idx)].map(photoUrl);
}

// Group riders by city for map markers
const ridersByCity = new Map<string, Array<{
  lat: number; lng: number; name: string; tkid: string;
  photo: string; location: string; message: string;
}>>();

riders.filter(r => r.latitude && r.longitude).forEach(r => {
  const city = r.location.split(',')[0]?.trim().toLowerCase() || 'unknown';
  if (!ridersByCity.has(city)) ridersByCity.set(city, []);
  ridersByCity.get(city)!.push({
    lat: r.latitude,
    lng: r.longitude,
    name: r.rider_name,
    tkid: `TKID-${String(r.registry_id).padStart(4, '0')}`,
    photo: photoUrl(coverPath(r)),
    location: r.location,
    message: r.message || '',
  });
});

// One marker per city, each containing all riders in that city
const mapMarkers = Array.from(ridersByCity.values()).map(group => ({
  lat: group[0].lat,
  lng: group[0].lng,
  riders: group,
}));

// Filter out customers whose city already has a rider (duck takes precedence)
const riderCitySet = new Set(riderCities);
const mapCustomers = stickerCustomers.filter(c => !riderCitySet.has(c.city.toLowerCase()));
---

<Layout title="TRACKID — Duck Sticker Rider Registry" description="TRACKID — Beijing roast duck sticker on steel fixies worldwide. Browse the global rider gallery, see every duck on the map, and claim your TKID." ogType="website">
  <!-- Hero -->
  <section class="section">
    <div class="section-header">
      <span class="section-label notranslate">TRACKID</span>
      <h1 class="display" style="font-size: 48px; font-weight: 700; letter-spacing: 4px; margin-top: 16px; line-height: 1.1;">
        The Dove<br />Became a Duck.
      </h1>
      <p style="max-width: 600px; margin-top: 20px; line-height: 1.7; color: var(--muted);">
        If you know the Columbus dove, you know what this sticker is. If you don't — it's a Beijing roast duck on a fixie, and it's already riding in dozens of countries. Show us where yours ended up — with a local's ride waiting behind every frame.
      </p>
    </div>
  </section>

  <!-- Gallery -->
  <section class="section">
    <div class="section-header">
      <span class="section-label notranslate" data-i18n="the-flock">The Flock</span>
      <h2 class="display" style="font-size: 32px; font-weight: 700; letter-spacing: 3px; margin-top: 16px; line-height: 1.1;">
        Every duck has a story.<br />Every frame has a city.
      </h2>
      <p style="margin-top: 14px; color: var(--muted); line-height: 1.6; font-size: 15px;">
        Tap any frame. Every city comes with a local's route — steal the line before you ever land.
      </p>
    </div>

    <StatsBar totalRiders={totalRiders} countries={countries} cities={cities} />

    {(mapMarkers.length > 0 || mapCustomers.length > 0) && <MapSection markers={mapMarkers} customers={mapCustomers} routes={routePolylines} />}

    {riders.length === 0 ? (
      <p style="color: var(--muted); margin-top: 32px;">No ducks spotted yet. <a href="/upload" style="color: var(--signal-red);">Be the first.</a></p>
    ) : (
      <div class="registry-grid" style="margin-top: 32px;">
        {riders.map(rider => (
          <RegistryCard
            registryId={rider.registry_id}
            riderName={rider.rider_name}
            location={rider.location}
            photoUrl={photoUrl(coverPath(rider))}
            photoUrls={orderedPhotoUrls(rider)}
            message={rider.message}
            route={routeForLocation(rider.location)}
            riderRoute={rider.route_suggestion}
          />
        ))}
      </div>
    )}
  </section>

  <!-- Lightbox -->
  <div class="lightbox-overlay" id="lightbox" style="display: none;">
    <button class="lightbox-close" id="lightbox-close" aria-label="Close">&times;</button>
    <div class="lightbox-content">
      <div class="lightbox-img-wrap">
        <img class="lightbox-img" id="lightbox-img" src="" alt="Rider photo" />
        <div class="lightbox-spinner" id="lightbox-spinner" hidden></div>
        <button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous photo">&lsaquo;</button>
        <button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next photo">&rsaquo;</button>
        <div class="lightbox-counter" id="lightbox-counter"></div>
      </div>
      <div class="lightbox-info">
        <div class="lightbox-tkid" id="lightbox-tkid"></div>
        <div class="lightbox-rider" id="lightbox-rider"></div>
        <div class="lightbox-loc" id="lightbox-loc"></div>
        <div class="lightbox-msg" id="lightbox-msg"></div>
        <div class="lightbox-rider-route" id="lightbox-rider-route" hidden>
          <div class="route-eyebrow" id="rider-route-eyebrow">Rider's pick</div>
          <div class="rider-route-text" id="rider-route-text"></div>
          <a class="route-link" id="rider-route-link" href="#" target="_blank" rel="noopener" hidden>Open this rider's route &rarr;</a>
        </div>
        <div class="lightbox-route" id="lightbox-route" hidden>
          <div class="route-eyebrow">Classic ride here</div>
          <div class="route-name" id="route-name"></div>
          <div class="route-stats" id="route-stats"></div>
          <div class="route-desc" id="route-desc"></div>
          <a class="route-link" id="route-link" href="#" target="_blank" rel="noopener">Open cycling route in Google Maps &rarr;</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom CTA -->
  <section class="section" style="text-align: center; padding: 80px 0;">
    <p style="font-size: 20px; font-weight: 600; font-family: 'Space Grotesk', sans-serif; letter-spacing: 2px;">
      No duck yet? Fix that.
    </p>
    <a href="https://www.aliexpress.com/item/1005010774387015.html" target="_blank" rel="noopener" class="btn btn-primary" style="margin-top: 20px;">
      Grab one on AliExpress &rarr;
    </a>
  </section>
</Layout>

<style>
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .lightbox-close {
    position: absolute;
    top: 16px;
    right: 24px;
    background: none;
    border: none;
    color: #fff;
    font-size: 36px;
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  .lightbox-close:hover {
    opacity: 1;
  }

  .lightbox-content {
    max-width: 720px;
    width: 100%;
    background: var(--paper);
    /* Scroll when the photo + info (route cards can make this tall) exceed the viewport,
       so the bottom is never clipped. 48px = the overlay's 24px top/bottom padding. */
    max-height: calc(100vh - 48px);
    max-height: calc(100dvh - 48px); /* dvh accounts for mobile browser chrome */
    overflow-y: auto;
    overflow-x: hidden;
  }

  .lightbox-img-wrap {
    position: relative;
  }

  .lightbox-img {
    width: 100%;
    max-height: 60vh;
    object-fit: contain;
    display: block;
    background: #000;
    transition: opacity 0.15s ease;
  }

  .lightbox-img.is-loading {
    opacity: 0.35;
  }

  .lightbox-spinner {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 36px;
    height: 36px;
    margin: -18px 0 0 -18px;
    border: 3px solid rgba(255, 255, 255, 0.25);
    border-top-color: #fff;
    border-radius: 50%;
    animation: lb-spin 0.8s linear infinite;
    pointer-events: none;
  }

  .lightbox-spinner[hidden] {
    display: none;
  }

  @keyframes lb-spin {
    to { transform: rotate(360deg); }
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: none;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 32px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s ease, opacity 0.15s ease;
    user-select: none;
  }

  .lightbox-nav:hover {
    background: var(--signal-red);
  }

  .lightbox-nav[hidden] {
    display: none;
  }

  .lightbox-prev {
    left: 8px;
  }

  .lightbox-next {
    right: 8px;
  }

  .lightbox-counter {
    position: absolute;
    bottom: 8px;
    right: 12px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    color: #fff;
    background: rgba(0, 0, 0, 0.55);
    padding: 3px 8px;
  }

  .lightbox-counter[hidden] {
    display: none;
  }

  .lightbox-info {
    padding: 20px 24px;
  }

  .lightbox-tkid {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: var(--signal-red);
    letter-spacing: 1px;
  }

  .lightbox-rider {
    font-family: 'IBM Plex Sans', sans-serif;
    font-size: 16px;
    font-weight: 500;
    margin-top: 4px;
  }

  .lightbox-loc {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: var(--muted);
    margin-top: 2px;
  }

  .lightbox-msg {
    margin-top: 12px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
  }

  .lightbox-msg:empty {
    display: none;
  }

  .lightbox-rider-route {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--weld);
  }

  .lightbox-rider-route[hidden] {
    display: none;
  }

  .rider-route-text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink);
    margin-top: 6px;
  }

  .rider-route-text[hidden] {
    display: none;
  }

  .lightbox-route {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--weld);
  }

  .lightbox-route[hidden] {
    display: none;
  }

  .route-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--signal-red);
  }

  .route-name {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 16px;
    font-weight: 600;
    margin-top: 6px;
  }

  .route-stats {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--muted);
    margin-top: 4px;
    text-transform: uppercase;
  }

  .route-stats:empty {
    display: none;
  }

  .route-desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--muted);
    margin-top: 8px;
  }

  .route-desc:empty {
    display: none;
  }

  .route-link {
    display: inline-block;
    margin-top: 12px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    letter-spacing: 1px;
    color: var(--signal-red);
    text-decoration: none;
    border-bottom: 1px solid var(--signal-red);
    padding-bottom: 2px;
  }

  .route-link[hidden] {
    display: none;
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lbTkid = document.getElementById('lightbox-tkid')!;
  const lbRider = document.getElementById('lightbox-rider')!;
  const lbLoc = document.getElementById('lightbox-loc')!;
  const lbMsg = document.getElementById('lightbox-msg')!;
  const lbRiderRoute = document.getElementById('lightbox-rider-route')!;
  const riderRouteEyebrow = document.getElementById('rider-route-eyebrow')!;
  const riderRouteText = document.getElementById('rider-route-text')!;
  const riderRouteLink = document.getElementById('rider-route-link') as HTMLAnchorElement;
  const lbRoute = document.getElementById('lightbox-route')!;
  const routeName = document.getElementById('route-name')!;
  const routeStats = document.getElementById('route-stats')!;
  const routeDesc = document.getElementById('route-desc')!;
  const routeLink = document.getElementById('route-link') as HTMLAnchorElement;
  const lbClose = document.getElementById('lightbox-close')!;
  const lbPrev = document.getElementById('lightbox-prev') as HTMLButtonElement;
  const lbNext = document.getElementById('lightbox-next') as HTMLButtonElement;
  const lbCounter = document.getElementById('lightbox-counter')!;
  const lbSpinner = document.getElementById('lightbox-spinner')!;

  let photos: string[] = [];
  let currentIndex = 0;
  let currentRider = '';
  let currentLocation = '';
  let renderToken = 0;

  function parsePhotos(raw: string | undefined, fallback: string): string[] {
    if (raw) {
      try {
        const arr = JSON.parse(raw);
        if (Array.isArray(arr) && arr.length > 0) return arr.filter((s): s is string => typeof s === 'string' && s.length > 0);
      } catch {}
    }
    return fallback ? [fallback] : [];
  }

  function preload(urls: string[]) {
    urls.forEach(url => { const img = new Image(); img.src = url; });
  }

  function render() {
    if (photos.length === 0) return;
    currentIndex = ((currentIndex % photos.length) + photos.length) % photos.length;
    const target = photos[currentIndex];
    const token = ++renderToken;
    lbImg.alt = `${currentRider || 'Rider'}'s TRACKID duck spotted in ${currentLocation || 'unknown location'}`;

    const multi = photos.length > 1;
    lbPrev.hidden = !multi;
    lbNext.hidden = !multi;
    lbCounter.hidden = !multi;
    if (multi) lbCounter.textContent = `${currentIndex + 1} / ${photos.length}`;

    const probe = new Image();
    const showLoading = () => {
      if (token !== renderToken) return;
      lbImg.classList.add('is-loading');
      lbSpinner.hidden = false;
    };
    // Only show loading state if the image hasn't already arrived in <80ms (cached images skip the flash)
    const loadingTimer = window.setTimeout(showLoading, 80);
    probe.onload = () => {
      window.clearTimeout(loadingTimer);
      if (token !== renderToken) return;
      lbImg.src = target;
      lbImg.classList.remove('is-loading');
      lbSpinner.hidden = true;
    };
    probe.onerror = () => {
      window.clearTimeout(loadingTimer);
      if (token !== renderToken) return;
      lbImg.src = target;
      lbImg.classList.remove('is-loading');
      lbSpinner.hidden = true;
    };
    probe.src = target;
    if (probe.complete && probe.naturalWidth > 0) {
      window.clearTimeout(loadingTimer);
      lbImg.src = target;
      lbImg.classList.remove('is-loading');
      lbSpinner.hidden = true;
    }
  }

  function renderRiderRoute(raw: string | undefined, rider: string) {
    const text = (raw || '').trim();
    if (!text) { lbRiderRoute.hidden = true; return; }
    riderRouteEyebrow.textContent = rider ? `${rider}'s pick` : "Rider's pick";
    // Pull the first URL out of the suggestion (Google Maps / Strava / komoot link).
    const urlMatch = text.match(/https?:\/\/[^\s]+/);
    riderRouteText.textContent = text;
    if (urlMatch) {
      riderRouteLink.href = urlMatch[0];
      riderRouteLink.hidden = false;
      // If the whole suggestion is just the bare URL, the link button alone is enough.
      riderRouteText.hidden = text === urlMatch[0];
    } else {
      riderRouteLink.hidden = true;
      riderRouteText.hidden = false;
    }
    lbRiderRoute.hidden = false;
  }

  function renderRoute(raw: string | undefined) {
    if (!raw) { lbRoute.hidden = true; return; }
    let route: any;
    try { route = JSON.parse(raw); } catch { lbRoute.hidden = true; return; }
    if (!route || !route.name) { lbRoute.hidden = true; return; }

    routeName.textContent = route.name;
    const stats: string[] = [];
    if (route.distance_km) stats.push(`${route.distance_km} km`);
    if (route.difficulty) stats.push(route.difficulty);
    routeStats.textContent = stats.join(' · ');
    routeDesc.textContent = route.description || '';
    if (route.mapUrl) {
      routeLink.href = route.mapUrl;
      routeLink.hidden = false;
    } else {
      routeLink.hidden = true;
    }
    lbRoute.hidden = false;
  }

  function openLightbox(el: HTMLElement) {
    photos = parsePhotos(el.dataset.photos, el.dataset.photo || '');
    currentIndex = 0;
    currentRider = el.dataset.rider || '';
    currentLocation = el.dataset.location || '';
    lbTkid.textContent = el.dataset.tkid || '';
    lbRider.textContent = currentRider;
    lbLoc.textContent = currentLocation;
    lbMsg.textContent = el.dataset.message || '';
    renderRiderRoute(el.dataset.riderRoute, currentRider);
    renderRoute(el.dataset.route);
    render();
    preload(photos.slice(1));
    lightbox.style.display = 'flex';
  }

  function closeLightbox() {
    lightbox.style.display = 'none';
  }

  function step(delta: number) {
    if (photos.length < 2) return;
    currentIndex += delta;
    render();
  }

  document.querySelectorAll('.registry-card').forEach(card => {
    card.addEventListener('click', () => openLightbox(card as HTMLElement));
  });

  lbClose.addEventListener('click', closeLightbox);
  lbPrev.addEventListener('click', (e) => { e.stopPropagation(); step(-1); });
  lbNext.addEventListener('click', (e) => { e.stopPropagation(); step(1); });

  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (lightbox.style.display === 'none') return;
    if (e.key === 'Escape') closeLightbox();
    else if (e.key === 'ArrowLeft') step(-1);
    else if (e.key === 'ArrowRight') step(1);
  });
</script>

